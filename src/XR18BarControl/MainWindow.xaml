<Window x:Class="XR18BarControl.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Control de audio" Width="1100" Height="760" MinWidth="480" MinHeight="340" WindowState="Maximized" ResizeMode="CanResize" Background="{StaticResource Background}" Icon="Assets/beer.ico" FontFamily="Liberation Sans">
 <Window.InputBindings><KeyBinding Key="F12" Command="{Binding AdminCommand}"/></Window.InputBindings>
 <Viewbox Stretch="Uniform" StretchDirection="Both"><Grid Width="1100" Height="760" Margin="42"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel HorizontalAlignment="Center"><TextBlock Text="CONTROL DE AUDIO" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,24"><Ellipse Width="20" Height="20" Fill="{Binding ConnectionBrush}" Margin="0,0,10,0"/><TextBlock Text="{Binding ConnectionText}" FontSize="21" FontWeight="SemiBold"/></StackPanel></StackPanel>
  <DockPanel Grid.Row="1" IsEnabled="{Binding ControlsEnabled}"><Button DockPanel.Dock="Right" Content="TODOS" Command="{Binding AllZonesCommand}" Background="#047857" MinWidth="160"/><ItemsControl ItemsSource="{Binding Zones}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Command="{Binding SelectCommand}" MinWidth="150"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,24"><StackPanel>
   <ItemsControl ItemsSource="{Binding Zones}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border MaxWidth="440" Background="{StaticResource Panel}" CornerRadius="18" Margin="8" Padding="20"><StackPanel><TextBlock Text="{Binding Name}" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center"/><Slider Minimum="0" Maximum="100" Value="{Binding Volume,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.ControlsEnabled,RelativeSource={RelativeSource AncestorType=Window}}"/><TextBlock Text="{Binding Volume,StringFormat={}{0:F0}%}" FontSize="32" HorizontalAlignment="Center"/><TextBlock Text="ACTIVA" Visibility="{Binding IsOn,Converter={StaticResource BoolToVisibility}}" Foreground="#4ADE80" HorizontalAlignment="Center" FontSize="17"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <ItemsControl ItemsSource="{Binding Inputs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border MaxWidth="440" Background="#312E81" CornerRadius="18" Margin="8" Padding="20"><StackPanel><TextBlock Text="{Binding Name}" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding Channel,StringFormat=ENTRADA {0}}" FontSize="15" Foreground="#C7D2FE" HorizontalAlignment="Center" Margin="0,0,0,4"/><Slider Minimum="0" Maximum="100" Value="{Binding Volume,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.ControlsEnabled,RelativeSource={RelativeSource AncestorType=Window}}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{Binding Volume,StringFormat={}{0:F0}%}" FontSize="32"/><TextBlock Text="{Binding DbText}" FontSize="20" Foreground="#C7D2FE" Margin="14,8,0,0"/></StackPanel><TextBlock Text="ACTIVA" Visibility="{Binding IsOn,Converter={StaticResource BoolToVisibility}}" Foreground="#4ADE80" HorizontalAlignment="Center" FontSize="17"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
  <TextBlock Grid.Row="3" Text="AJUSTES" Foreground="#374151" FontSize="12" Padding="40,12" HorizontalAlignment="Center" MouseLeftButtonDown="Admin_MouseDown" MouseLeftButtonUp="Admin_MouseUp" MouseLeave="Admin_MouseLeave"/>
 </Grid></Viewbox>
</Window>
