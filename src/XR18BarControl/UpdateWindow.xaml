<Window x:Class="XR18BarControl.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Actualización disponible" Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="#0F172A" FontFamily="Segoe UI" Icon="Assets/beer.ico" ResizeMode="NoResize" ShowInTaskbar="False">
 <Window.Resources>
  <Style x:Key="ModernButton" TargetType="Button">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="Padding" Value="20,12"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Opacity" Value="0.85"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <StackPanel Margin="32">
  <TextBlock Text="ACTUALIZACIÓN DISPONIBLE" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16"/>
  <TextBlock x:Name="MessageText" Foreground="#D1D5DB" FontSize="16" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
   <Button Content="AHORA NO" Click="Later_Click" Background="#374151" Style="{StaticResource ModernButton}" Margin="0,0,12,0"/>
   <Button Content="ACTUALIZAR" Click="Update_Click" Background="#3B82F6" Style="{StaticResource ModernButton}"/>
  </StackPanel>
 </StackPanel>
</Window>
